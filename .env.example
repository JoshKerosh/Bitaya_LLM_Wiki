# Bitaya usa el CLI de Claude Code (no la API), así que no necesitás API key.
# Solo asegurate de tener `claude` instalado y autenticado (corré `claude` una vez para login).

# Modelo: 'sonnet' | 'haiku' | 'opus' o ID completo (ej. 'claude-sonnet-4-6')
BITAYA_MODEL=sonnet

# Path al CLI si no está en PATH (default: 'claude')
# BITAYA_CLAUDE_CMD=/Users/tu-user/.local/bin/claude

# Timeout en ms para cada respuesta (default 120000 = 2 min)
# BITAYA_TIMEOUT_MS=120000

# Puerto del backend Express. Vite usa el mismo valor para proxyear /api.
# 8787 evita choques comunes con backends Python en 8000.
PORT=8787

# Dejá vacío para usar el proxy de Vite. En prod, seteá la URL del backend.
VITE_API_BASE_URL=
